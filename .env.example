# ============================================================
# LLM API Key - pick one; whichever you fill in selects the provider
# ============================================================

# Anthropic Claude (default)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=sk-xxxxx

# Alibaba Cloud Bailian / Tongyi Qwen (OpenAI-compatible)
# DASHSCOPE_API_KEY=sk-xxxxx

# Other OpenAI-compatible endpoints
# OPENAI_API_KEY=sk-xxxxx

# ============================================================
# MCP Server transport mode
# ============================================================

# Transport mode: stdio (called by an MCP client) or streamable-http (local HTTP)
MCP_TRANSPORT=streamable-http

# Listen address and port for HTTP mode (ignored in stdio mode)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ============================================================
# CorelDRAW connection (optional, has defaults)
# ============================================================

# CorelDRAW COM application name, usually no need to change
# COREL_CORELDRAW_APP_NAME=CorelDRAW.Application

# Whether to show the CorelDRAW window on startup
# COREL_CORELDRAW_VISIBLE=true

# Max retry attempts when the COM connection fails
# COREL_MAX_RETRY_ATTEMPTS=3

# ============================================================
# Paths (optional, have defaults)
# ============================================================

# CDR template file directory
# COREL_TEMPLATES_DIR=templates

# Export output directory
# COREL_OUTPUT_DIR=output
